---
import { clases } from '../data/curso';
---
<section id="cronograma">
  <div class="container">
    <div class="section-header">
      <span class="label">03 — Cronograma</span>
      <h2>Clase<br>a clase</h2>
    </div>

    <div style="overflow-x:auto;">
      <table class="schedule-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Fecha</th>
            <th>Contenido</th>
          </tr>
        </thead>
        <tbody>
          {clases.map((c) => (
            <>
              {c.num === "02" && (
                <tr class="unit-divider">
                  <td colspan="3">Unidad 1 · Producción creativa — clases 02 a 07</td>
                </tr>
              )}
              {c.num === "08" && (
                <tr class="unit-divider">
                  <td colspan="3">Unidad 2 · Intermedio reflexivo — clases 08 a 09</td>
                </tr>
              )}
              {c.num === "10" && (
                <tr class="unit-divider">
                  <td colspan="3">Unidad 3 · Interfaces UX/UI/Web — clases 10 a 15</td>
                </tr>
              )}
              {c.num === "16" && (
                <tr class="unit-divider">
                  <td colspan="3">Presentación final — clase 16</td>
                </tr>
              )}
              <tr>
                <td class="num">{c.num}</td>
                <td class="date">{c.fecha}</td>
                <td class="title">{c.titulo}</td>
              </tr>
            </>
          ))}
        </tbody>
      </table>
    </div>

    <div style="margin-top:32px; display:flex; flex-wrap:wrap; gap:16px; font-size:12px; color:var(--text-dim);">
      <span>Evaluaciones →</span>
      <span><span style="color:var(--white)">Proyecto U1</span> · 35% · Clase 07 (29 sep)</span>
      <span><span style="color:var(--white)">Ensayo reflexivo</span> · 20% · 20 oct 23:59</span>
      <span><span style="color:var(--white)">Proyecto U3</span> · 35% · Clase 16 (01 dic)</span>
      <span><span style="color:var(--white)">Participación</span> · 10% · Continua</span>
    </div>

    <div style="margin-top:24px; font-size:12px; color:var(--text-dim); max-width:640px; line-height:1.8;">
      <span style="color:var(--white)">Notas:</span> la entrega de notas y retroalimentación tiene un plazo de hasta 3 semanas posteriores a cada fecha de entrega.
    </div>
  </div>
</section>
