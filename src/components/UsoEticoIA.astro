---
import { eticaItems } from '../data/curso';
---
<section id="uso-etico-ia">
  <div class="container">
    <div class="section-header">
      <span class="label">07 — Uso ético de la IA</span>
      <h2>Cómo usamos<br>esta tecnología</h2>
    </div>
    <p style="font-size:14px; color:var(--text-dim); max-width:640px; margin-bottom:48px;">
      El curso enseña a trabajar con inteligencia artificial, no a esconderse detrás de ella. Estos principios guían el uso responsable, transparente y crítico de las herramientas generativas en cada entrega y ejercicio del semestre.
    </p>

    <div class="conduct-grid">
      {eticaItems.map((item) => (
        <div class="conduct-block">
          <div class="conduct-num">{item.num}</div>
          <div class="conduct-title">{item.titulo}</div>
          <p class="conduct-desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
