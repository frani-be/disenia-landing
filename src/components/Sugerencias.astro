---
---
<section id="sugerencias">
  <div class="container">
    <div class="section-header">
      <span class="label">09 — Sugerencias</span>
      <h2>¿Tienes algo<br>que decir?</h2>
    </div>
    <p style="font-size:14px; color:var(--text-dim); max-width:560px; margin-bottom:40px;">Sugerencias de herramientas, temas para explorar, errores en el material, o lo que sea. El curso se mejora con tu input.</p>

    <form
      name="sugerencias"
      method="POST"
      action="https://formspree.io/f/placeholder"
      style="max-width:680px;"
    >
      <div class="form-grid">
        <div class="form-field">
          <label for="nombre">Nombre</label>
          <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" autocomplete="given-name" />
        </div>
        <div class="form-field">
          <label for="email">Correo</label>
          <input type="email" id="email" name="email" placeholder="tu@correo.cl" autocomplete="email" />
        </div>
        <div class="form-field full">
          <label for="tipo">Tipo de sugerencia</label>
          <select id="tipo" name="tipo">
            <option value="">Selecciona una categoría</option>
            <option value="herramienta">Herramienta que debería estar en el curso</option>
            <option value="tema">Tema que falta cubrir</option>
            <option value="error">Error en el material</option>
            <option value="clase">Feedback sobre una clase específica</option>
            <option value="otro">Otro</option>
          </select>
        </div>
        <div class="form-field full">
          <label for="mensaje">Mensaje</label>
          <textarea id="mensaje" name="mensaje" placeholder="Escribe tu sugerencia aquí..."></textarea>
        </div>
        <div class="form-field full form-submit">
          <button type="submit" class="btn-primary">Enviar sugerencia →</button>
          <p class="form-note">Tu correo solo se usa para responderte. No se comparte con nadie.</p>
        </div>
      </div>
    </form>
  </div>
</section>
